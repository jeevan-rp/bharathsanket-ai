# Mapbox Public Access Token
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Firebase Web Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=bharatsanket-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bharatsanket-ai
VITE_FIREBASE_STORAGE_BUCKET=bharatsanket-ai.appspot.com
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# Backend API Base URL (leave empty in local dev, set to deployed backend URL in Vercel)
# Example: https://bharatsanket-backend.onrender.com
VITE_API_URL=
