# Firebase Configuration
# Option 1: Path to Firebase Service Account JSON file (e.g. ./config/serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Option 2: Full JSON string of service account key (useful in Cloud Run / CI / Docker)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Option 3: Individual service account credentials
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server port (Cloud Run default)
PORT=8080
